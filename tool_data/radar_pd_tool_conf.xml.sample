<?xml version="1.0"?>
<!-- Merge this section into a configured Galaxy tool configuration, or add this
     file to tool_config_file. Paths are relative to Galaxy's configured tool root.
     The wrappers intentionally retain their _prototype IDs for NOVA compatibility. -->
<toolbox>
    <section id="radar_pd" name="RADAR-PD">
        <tool file="neutrons/powder_diffraction/radar_pd_nova.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_analyze.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_configure.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_resolve_sns_input.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_facility_access_probe.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_library_builder.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_compare_series.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_gpx_handoff.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_gsasii_interactive.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_result_explorer.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_refine_recipe.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_model_campaign.xml"/>
        <tool file="neutrons/powder_diffraction/radar_pd_live_snapshot.xml"/>
    </section>
</toolbox>
