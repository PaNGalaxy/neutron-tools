<macros>
    <xml name="preparation_benchmark_body">
    <command detect_errors="exit_code"><![CDATA[
        touch '$result_bundle' '$console_output' '$preparation_certificate' &&
        trap "chmod a+r '$result_bundle' '$console_output' '$preparation_certificate' >/dev/null 2>&1 || true" EXIT &&
        python '$runtime_probe' >> '$console_output' 2>&1 &&
        #if $model_request_b64 and $model_request
            echo 'Supply exactly one reviewed request source' >&2; exit 1
        #elif $model_request_b64
            python '$request_decoder' '$inline_request' decoded-model-request.json &&
            python /opt/radar-symmetry/ndip_model_campaign.py '$action' '$source_gpx' '$model_assets' decoded-model-request.json worker '$result_bundle' \
            #if $model_asset_parts
                #for $part in $model_asset_parts
                    --asset-part '$part' \
                #end for
            #end if
                --preparation-evidence '$preparation_provenance' --preparation-certificate '$preparation_certificate' >> '$console_output' 2>&1 &&
            python -m gpx_recipe.preparation.certificates '$preparation_certificate'
        #elif $model_request
            python /opt/radar-symmetry/ndip_model_campaign.py '$action' '$source_gpx' '$model_assets' '$model_request' worker '$result_bundle' \
            #if $model_asset_parts
                #for $part in $model_asset_parts
                    --asset-part '$part' \
                #end for
            #end if
                --preparation-evidence '$preparation_provenance' --preparation-certificate '$preparation_certificate' >> '$console_output' 2>&1 &&
            python -m gpx_recipe.preparation.certificates '$preparation_certificate'
        #else
            echo 'Supply one reviewed request source' >&2; exit 1
        #end if
    ]]></command>
    <configfiles>
        <configfile name="runtime_probe"><![CDATA[import json, shutil, subprocess
from gpx_recipe.symmetry.resources import allocation
import torch
details=dict(schema='radar-preparation-device-probe/v1', allocation=allocation(4),
    torch_version=str(torch.__version__), cuda_build=torch.version.cuda,
    cuda_available=torch.cuda.is_available(), cuda_devices=torch.cuda.device_count())
if details['cuda_available']:
    details['gpu_names']=[torch.cuda.get_device_name(i) for i in range(details['cuda_devices'])]
binary=shutil.which('nvidia-smi')
if binary:
    try:
        result=subprocess.run([binary,'--query-gpu=name,memory.total','--format=csv,noheader'],
            capture_output=True,text=True,timeout=5)
        details['visible_nvidia_devices']=result.stdout[:4096] if result.returncode==0 else 'not available to this job'
    except subprocess.TimeoutExpired:details['visible_nvidia_devices']='probe timed out'
print('[RADAR PREPARATION DEVICE] '+json.dumps(details,sort_keys=True))
]]></configfile>

