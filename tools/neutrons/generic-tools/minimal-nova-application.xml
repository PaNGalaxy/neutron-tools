<tool id="nova-interactive-tool-vscode-prototype" tool_type="interactive" name="VSCode Editor" version="1.127.0" profile="22.05">
    <creator>
        <person name="John Duggan" />
        <organization url="https://www.ornl.gov/" name="ORNL"/>
    </creator>
    <requirements>
        <container type="docker" shell="/bin/bash">savannah.ornl.gov/ndip/tool-sources/generic/vscode:0.1</container>
    </requirements>
    <entry_points>
        <entry_point name="VSCode" label="vscode" requires_domain="False" requires_path_in_url="True">
            <port>8080</port>
        </entry_point>
    </entry_points>
    <environment_variables>
        <environment_variable name="GALAXY_URL">$__galaxy_url__</environment_variable>
        <environment_variable name="GALAXY_API_KEY" inject="api_key" />
        <environment_variable name="EP_PATH" inject="entry_point_path_for_label">vscode</environment_variable>
    </environment_variables>
    <command><![CDATA[
        echo "Starting VSCode" > $output &&
        export GALAXY_WORKING_DIR=`pwd` &&
        /start.sh \$GALAXY_TOOL_USER
    ]]></command>
    <inputs>
    </inputs>
    <outputs>
        <data name="output" auto_format="true" label="VSCode Console Output"></data>
    </outputs>
    <help><![CDATA[
        Starts a VSCode editor in a web browser.
    ]]></help>
</tool>
